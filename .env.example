# Syntropix Console (Community Edition). Cloud: https://console.syntropix.io — see docs/NAMING.md
PORT=5001
DATABASE_URL=postgres://aegisops:aegisops@localhost:5433/aegisops?sslmode=disable
# Teams: Incoming Webhook OR Power Automate HTTP trigger (NOT teams.microsoft.com/l/team/... links)
TEAMS_WEBHOOK_URL=
AEGIS_WEBHOOK_SECRET=dev-webhook-secret
COPILOT_API_URL=http://localhost:5000
COPILOT_SERVICE_TOKEN=
SPOTTING_API_URL=http://localhost:3000
SPOTTING_SERVICE_TOKEN=
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=owner/repo
# Self-host: http://localhost:5001 — Cloud: https://console.syntropix.io
AEGISOPS_PUBLIC_URL=http://localhost:5001
DEPLOY_VERIFY_URL=
DEPLOY_VERIFY_TTL_MIN=30
ROLLBACK_WEBHOOK_URL=
ROLLBACK_WORKFLOW=
# Non-secret platform defaults for workspace connectors (Connections → Connect from platform defaults)
AWS_REGION=ap-south-1
EC2_INSTANCE_ID=
SECRETS_MANAGER_ID=dev/syntropix
# When true, POST /start-fix requires gateway approve first (status already in_progress)
AEGISOPS_REQUIRE_GATEWAY=false
GITHUB_APP_INSTALLATION_ID=
SLACK_WEBHOOK_URL=
WEBHOOK_RATE_LIMIT=120
AEGISOPS_ENV=development

# HTTP API auth (Bearer). Empty + development = insecure default-admin (local only).
# Production requires AEGISOPS_API_TOKEN (>=16 chars) unless AEGISOPS_ALLOW_INSECURE_AUTH=true.
AEGISOPS_API_TOKEN=
# AEGISOPS_ALLOW_INSECURE_AUTH=false
# Optional actor user id when token auth succeeds (default 1 = bootstrap admin)
# AEGISOPS_AUTH_USER_ID=1
# Optional bake-in for static UI (prefer Settings → API token / localStorage instead)
# NEXT_PUBLIC_AEGISOPS_API_TOKEN=

# Workspace secret encryption (AES-256-GCM). Prefer: openssl rand -hex 32
# Required in production — empty falls back to a LOCAL-ONLY default (never use in prod).
WORKSPACE_SECRETS_KEY=

# Phase 4 dogfood — Copilot Sentry ingest (DevOps Copilot → Observability → DSN)
# Docker: use host.docker.internal instead of localhost in the DSN host
SENTRY_DSN=

# Spotting embed (baked into dashboard at `npm run build` / Docker build)
NEXT_PUBLIC_SPOTTING_PUBLIC_KEY=
NEXT_PUBLIC_SPOTTING_API_URL=http://localhost:3000
NEXT_PUBLIC_SPOTTING_DASHBOARD_URL=http://127.0.0.1:3001