# Copy to /opt/spotting/.env on EC2, then rebuild web (see below)

NEXT_PUBLIC_SITE_URL=https://spotting.syntropix.io
NEXT_PUBLIC_APP_URL=https://spotting.syntropix.io
NEXT_PUBLIC_SERVER_URL=https://api.spotting.syntropix.io

CORS_ORIGINS=https://spotting.syntropix.io,https://aegisops.syntropix.io
SPOTTING_AUTH_URL=https://api.spotting.syntropix.io
SPOTTING_AUTH_SECRET=CHANGE_ME_openssl_rand_hex_32

DOCKER_BIND_HOST=127.0.0.1
WEB_PORT=3001
API_PORT=3000

POSTGRES_DB=spotting
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# AegisOps closed loop
AEGISOPS_WEBHOOK_URL=https://aegisops.syntropix.io/api/v1/webhooks/spotting
AEGISOPS_WEBHOOK_SECRET=CHANGE_ME_same_as_aegisops
