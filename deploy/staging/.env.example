# Staging environment — copy to deploy/staging/.env on EC2
AEGISOPS_ENV=production
AEGISOPS_PUBLIC_URL=https://aegisops.syntropix.io
PORT=5001

POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

AEGIS_WEBHOOK_SECRET=CHANGE_ME
GITHUB_WEBHOOK_SECRET=CHANGE_ME

COPILOT_API_URL=http://host.docker.internal:5000
SPOTTING_API_URL=http://host.docker.internal:3000
COPILOT_SERVICE_TOKEN=
SPOTTING_SERVICE_TOKEN=

# Phase 8: prefer GitHub App over PAT (see docs/RUNBOOK.md)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=/secrets/github-app.pem
GITHUB_APP_SECRETS_DIR=/opt/aegisops/secrets
GITHUB_TOKEN=
GITHUB_DEFAULT_REPO=kkjayakumar/AegIsOps
GITHUB_DEFAULT_BRANCH=main

# Optional — only if GHCR package is private
GHCR_USER=kkjayakumar
GHCR_TOKEN=

# Required in production — AES-256-GCM key for workspace secrets (openssl rand -hex 32)
WORKSPACE_SECRETS_KEY=

TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

DEPLOY_VERIFY_URL=https://aegisops.syntropix.io/healthz
DEPLOY_VERIFY_TTL_MIN=30
ROLLBACK_WORKFLOW=rollback.yml
ROLLBACK_WEBHOOK_URL=
AWS_REGION=ap-south-1
EC2_INSTANCE_ID=i-0350a48d3222dd239
SECRETS_MANAGER_ID=dev/syntropix
# Enforce HITL before dashboard/MCP start-fix
AEGISOPS_REQUIRE_GATEWAY=false

# HTTP API bearer token (required in production). Deploy auto-generates into Secrets Manager if missing.
# Paste the same value in dashboard Settings → Security → API access token.
AEGISOPS_API_TOKEN=
# Emergency only — allows spoofable X-User-* again (never leave on)
# AEGISOPS_ALLOW_INSECURE_AUTH=false
# AEGISOPS_AUTH_USER_ID=1

WEBHOOK_RATE_LIMIT=120

# Spotting embed (bake at Docker build via compose build args)
NEXT_PUBLIC_SPOTTING_PUBLIC_KEY=
NEXT_PUBLIC_SPOTTING_API_URL=https://api.spotting.syntropix.io
NEXT_PUBLIC_SPOTTING_DASHBOARD_URL=https://spotting.syntropix.io

SENTRY_DSN=

# Rewrite loopback in Copilot ingest DSN (127.0.0.1 → public monitoring host)
COPILOT_INGEST_PUBLIC_URL=https://monitoring.syntropix.io

# Phase 9 dogfood on staging (debug/trigger-error + dashboard panel while AEGISOPS_ENV=production)
AEGISOPS_ALLOW_DOGFOOD=true
